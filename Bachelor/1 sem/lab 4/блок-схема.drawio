        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;flowchart&#39;: {&#39;curve&#39;: &#39;stepBefore&#39;}}}%%\nflowchart TD\n    Start([Начало]) --&gt; Init[setlocale, srand]\n    Init --&gt; InputN[/Ввод размера массива n/]\n    \n    %% Блок 1: Заполнение\n    InputN --&gt; GenInit[i = 0]\n    GenInit --&gt; GenCond{i &lt; n?}\n    GenCond -- Да --&gt; GenBody[a[i] = rand % 15]\n    GenBody --&gt; GenInc[i++]\n    GenInc --&gt; GenCond\n    \n    %% Блок 2: Вывод исходного\n    GenCond -- Нет --&gt; PrintInit1[i = 0]\n    PrintInit1 --&gt; PrintCond1{i &lt; n?}\n    PrintCond1 -- Да --&gt; PrintBody1[/Вывод a[i]/]\n    PrintBody1 --&gt; PrintInc1[i++]\n    PrintInc1 --&gt; PrintCond1\n    \n    %% Блок 3: Поиск минимума\n    PrintCond1 -- Нет --&gt; MinInit[a_min = 1000, i = 0]\n    MinInit --&gt; MinCond{i &lt; n?}\n    MinCond -- Да --&gt; MinDecide{a[i] &lt; a_min?}\n    MinDecide -- Да --&gt; UpdateMin[a_min = a[i]]\n    UpdateMin --&gt; MinInc[i++]\n    MinDecide -- Нет --&gt; MinInc\n    MinInc --&gt; MinCond\n    \n    %% Блок 4: Удаление минимумов\n    MinCond -- Нет --&gt; RemInit[i = 0]\n    RemInit --&gt; RemCond{i &lt; n?}\n    RemCond -- Да --&gt; RemDecide{a[i] == a_min?}\n    \n    RemDecide -- Да --&gt; ShiftInit[j = i]\n    ShiftInit --&gt; ShiftCond{j &lt; n - 1?}\n    ShiftCond -- Да --&gt; ShiftBody[a[j] = a[j+1]]\n    ShiftBody --&gt; ShiftInc[j++]\n    ShiftInc --&gt; ShiftCond\n    ShiftCond -- Нет --&gt; SizeDec[n--]\n    SizeDec --&gt; IndexDec[i--]\n    IndexDec --&gt; RemInc[i++]\n    \n    RemDecide -- Нет --&gt; RemInc\n    RemInc --&gt; RemCond\n    \n    %% Блок 5: Среднее арифметическое\n    RemCond -- Нет --&gt; SumInit[sum = 0, i = 0]\n    SumInit --&gt; SumCond{i &lt; n?}\n    SumCond -- Да --&gt; SumBody[sum += a[i]]\n    SumBody --&gt; SumInc[i++]\n    SumInc --&gt; SumCond\n    SumCond -- Нет --&gt; CalcAvg[s_arfm = sum / n]\n    \n    %% Блок 6: Сдвиг и вставка\n    CalcAvg --&gt; InsInit[i = 0]\n    InsInit --&gt; InsCond1{i &lt; 3?}\n    \n    InsCond1 -- Да --&gt; InsShiftInit[j = n - 1]\n    InsShiftInit --&gt; InsShiftCond{j &gt;= i?}\n    InsShiftCond -- Да --&gt; InsShiftBody[a[j+1] = a[j]]\n    InsShiftBody --&gt; InsShiftDec[j--]\n    InsShiftDec --&gt; InsShiftCond\n    \n    InsShiftCond -- Нет --&gt; InsertAvg[a[i] = s_arfm]\n    InsertAvg --&gt; SizeInc[n++]\n    SizeInc --&gt; InsInc[i++]\n    InsInc --&gt; InsCond1\n    \n    %% Блок 7: Финальный вывод\n    InsCond1 -- Нет --&gt; PrintInit2[i = 0]\n    PrintInit2 --&gt; PrintCond2{i &lt; n?}\n    PrintCond2 -- Да --&gt; PrintBody2[/Вывод a[i]/]\n    PrintBody2 --&gt; PrintInc2[i++]\n    PrintInc2 --&gt; PrintCond2\n    \n    PrintCond2 -- Нет --&gt; End([Конец])\n\n    %% Стилизация\n    classDef process fill:#e1f5fe,stroke:#01579b,stroke-width:2px;\n    classDef decision fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;\n    classDef io fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;\n    \n    class GenBody,UpdateMin,ShiftBody,SizeDec,IndexDec,SumBody,CalcAvg,InsShiftBody,InsertAvg,SizeInc process;\n    class GenCond,PrintCond1,MinCond,MinDecide,RemCond,RemDecide,ShiftCond,SumCond,InsCond1,InsShiftCond,PrintCond2 decision;\n    class InputN,PrintBody1,PrintBody2 io;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="102">
