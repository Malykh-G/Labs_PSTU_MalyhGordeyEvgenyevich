        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Задаем красивые цвета для блоков\n    classDef startend fill:#d5e8d4,stroke:#82b366,stroke-width:2px,color:#000;\n    classDef process fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px,color:#000;\n    classDef decision fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#000;\n    classDef inputoutput fill:#f8cecc,stroke:#b85450,stroke-width:2px,color:#000;\n    classDef func fill:#e1d5e7,stroke:#9673a6,stroke-width:2px,color:#000;\n\n    A([Начало программы]) ::: startend --&gt; B[/Ввод количества строк n и столбцов m/] ::: inputoutput\n    B --&gt; C[/Ввод элементов матрицы с клавиатуры/] ::: inputoutput\n    C --&gt; D[/Вывод введенной матрицы на экран/] ::: inputoutput\n    D --&gt; E[Вызов функции findSplit] ::: process\n\n    %% Описываем логику функции findSplit\n    subgraph findSplit_Logic [Логика работы findSplit]\n        E1{Цикл k от 1 до m-2} ::: decision\n        E --&gt; E1\n        E1 -- Итерация --&gt; E2[Вызов getsum: сумма слева 0..k-1] ::: func\n        E2 --&gt; E3[Вызов getsum: сумма справа k+1..m-1] ::: func\n        E3 --&gt; E4{leftSum &gt; rightSum?} ::: decision\n        E4 -- Да (условие выполнено) --&gt; E5[Возврат k (номера столбца)] ::: process\n        E4 -- Нет (идем дальше) --&gt; E1\n        E1 -- Цикл завершен, ничего не нашли --&gt; E6[Возврат -1] ::: process\n    end\n\n    %% Вывод результата в main\n    E5 --&gt; F{result != -1?} ::: decision\n    E6 --&gt; F\n    F -- Да --&gt; G[/Вывод: Найден подходящий столбец result/] ::: inputoutput\n    F -- Нет --&gt; H[/Вывод: Подходящий столбец не найден/] ::: inputoutput\n    \n    G --&gt; I([Конец программы]) ::: startend\n    H --&gt; I&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="34">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;strokeColor=none;" vertex="1">
